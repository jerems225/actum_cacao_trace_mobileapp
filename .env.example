EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="__public__"
EXPO_PUBLIC_GPS_MIN_ACCURACY_METERS="10"
# Autoriser la simulation GPS quand le capteur est indisponible (émulateur).
# Mettre "false" en production pour exiger des coordonnées réelles (traçabilité).
EXPO_PUBLIC_ALLOW_GPS_SIMULATION="true"
