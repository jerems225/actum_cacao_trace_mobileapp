# ============================================================================
# Actum Collect — Variables d'environnement du mobile
# ----------------------------------------------------------------------------
# Copier ce fichier en `.env` et renseigner les valeurs de VOTRE environnement.
#
# Rappel : Expo fige les variables EXPO_PUBLIC_* dans le bundle AU MOMENT DU
# BUILD. Elles sont donc extractibles d'un APK — n'y mettre aucune valeur qui
# doive rester secrète. Un changement ici impose de relancer le serveur de
# développement, ou de reconstruire l'application.
# ============================================================================

# URL du backend, terminée par le préfixe d'API versionné.
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Précision GPS minimale acceptée, en mètres. Au-delà, le relevé est refusé :
# un point à 40 m de précision ne délimite pas une parcelle.
EXPO_PUBLIC_GPS_MIN_ACCURACY_METERS="10"

# Autoriser la simulation GPS quand le capteur est indisponible (émulateur).
# Mettre "false" en production pour exiger des coordonnées réelles (traçabilité).
EXPO_PUBLIC_ALLOW_GPS_SIMULATION="true"

# ----------------------------------------------------------------------------
# Les clés Supabase ont été retirées : l'application mobile ne parle qu'au
# backend, qui porte seul les accès au stockage et à la base. Elles figuraient
# dans le `.env` sans être lues nulle part dans le code — une clé embarquée
# dans un APK et jamais utilisée n'est qu'une surface d'attaque de plus.
# ----------------------------------------------------------------------------
