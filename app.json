{
  "expo": {
    "name": "Actum Collect",
    "slug": "actumcollect",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "actumcollect",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.actumdev.actumcollect"
    },
    "android": {
      "package": "ci.actumdev.actumcollect",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ionicons.ttf"
          ]
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "owner": "jeremie.niondo",
    "extra": {
      "eas": {
        "projectId": "1970953c-7800-4dfb-863c-c9b264e4c8c5"
      }
    }
  }
}
